# ====================================================================
#  Happy inside expérience — نموذج المتغيرات البيئية / Modèle .env
#  انسخ هذا الملف إلى .env أو أضف المتغيرات مباشرة في Vercel / Railway
#  Copiez ce fichier en .env, ou ajoutez les variables directement
#  dans Vercel / Railway (Settings → Environment Variables)
# ====================================================================

# --------------------------------------------------------------------
# 1) قاعدة البيانات MongoDB — إلزامي / Base de données — REQUIS
# --------------------------------------------------------------------
# أنشئ مجموعة مجانية على MongoDB Atlas (الخطوات في README.md) ثم ضع رابط
# الاتصال هنا. لا تنسَ: Database Access (مستخدم+كلمة مرور) و Network Access
# (السماح 0.0.0.0/0 لأي استضافة سحابية).
#
# Créez un cluster gratuit sur MongoDB Atlas (voir README.md) puis collez
# l'URL de connexion. N'oubliez pas: Database Access + Network Access
# (0.0.0.0/0 pour autoriser Vercel/Railway).
#
# مثال / Exemple:
# MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# اسم قاعدة البيانات / Nom de la base de données
MONGODB_DB=happy_inside_experience

# --------------------------------------------------------------------
# 2) حساب الأديمن / Compte administrateur — إلزامي / REQUIS
# --------------------------------------------------------------------
# يُطبَّق تلقائياً عند كل إقلاع (حتى لو كانت القاعدة مهيأة سلفًا):
# غيّر القيم هنا أو في Vercel/Railway وأعد النشر فقط.
# Synchronisé automatiquement à chaque démarrage, même si la base existe.
ADMIN_PHONE=0555555555
ADMIN_PASSWORD=HappyInside@2026
ADMIN_FULLNAME=مدير الموقع / Administrateur

# --------------------------------------------------------------------
# 3) مفتاح الجلسات / Secret des sessions — إلزامي / REQUIS
# --------------------------------------------------------------------
# وقّع به كوكيز الدخول — ولّد قيمة عشوائية جديدة لكل نشر ولا تشاركها:
# Il signe les cookies de connexion — générez-en un pour chaque déploiement:
#   openssl rand -hex 48
AUTH_SECRET=

# --------------------------------------------------------------------
# 4) أمان الكوكي (اختياري / optionnel)
# --------------------------------------------------------------------
# افتراضيًا: الكوكي آمن (Secure) في وضع الإنتاج (HTTPS على Vercel/Railway).
# اضبطه على false فقط إذا استضفت الموقع بنفسك عبر HTTP عادي.
# Par défaut: cookie Secure en production (HTTPS). Mettre false uniquement
# pour un auto-hébergement en HTTP simple.
# COOKIE_SECURE=true

# --------------------------------------------------------------------
# 5) إشعارات Push (VAPID) — اختياري / optionnel
# --------------------------------------------------------------------
# إن تُركت فارغة تُولَّد مفاتيح تلقائية عند أول تشغيل.
# Si vides, des clés sont générées automatiquement au premier démarrage.
# لإعادة التوليد / pour régénérer :
#   npm exec -p web-push -- web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@happyinside-experience.dz

# --------------------------------------------------------------------
# 6) التواصل (أول تهيئة فقط، ثم من لوحة التحكم) / Contact
#    (1er lancement uniquement, ensuite depuis le tableau de bord admin)
# --------------------------------------------------------------------
WHATSAPP_NUMBER=213550000000
CONTACT_EMAIL=contact@happyinside-experience.dz
FACEBOOK_URL=https://facebook.com/happyinside.experience
INSTAGRAM_URL=https://instagram.com/happyinside.experience

# --------------------------------------------------------------------
# 7) المساعد الذكي (اختياري / optionnel) — للنشر على Vercel / Railway
# --------------------------------------------------------------------
# المساعد يعمل تلقائيًا في بيئة التطوير الأصلية. للنشر السحابي يمكن
# ربط أي مزوّد متوافق مع OpenAI (OpenAI، Groq، OpenRouter، Mistral…).
# إن تُركت فارغة يرد المساعد برسالة توضيحية لطيفة دون أي خطأ.
#
# Connectez n'importe quel fournisseur compatible OpenAI. Si vides,
# l'assistant répond avec un message de repli gracieux (aucune erreur).
#
#   AI_API_URL=https://api.openai.com/v1            (أو / ou https://api.groq.com/openai/v1)
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o-mini                            (أو / ou llama-3.3-70b-versatile)
AI_API_URL=
AI_API_KEY=
AI_MODEL=
